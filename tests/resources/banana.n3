@prefix ex: <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Banana a ex:Fruit ;
  ex:hasColor "yellow" ;
  ex:hasTaste "sweet" ;
  ex:hasShape "curved" ;
  ex:hasWeight "120 grams" ;
  ex:growsIn ex:TropicalClimate ;
  ex:isEdible "true"^^xsd:boolean ;
  ex:hasVitamin ex:VitaminB6 ;
  ex:hasPrice "$0.50" ;
  ex:hasOrigin "Ecuador" .

ex:Fruit a rdfs:Class ;
  rdfs:label "Fruit" .
